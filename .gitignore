# Build output
build/
dist/
*.spec
__pycache__/
*.py[cod]

# Local environment
.venv/
venv/

# Machine-specific settings and runtime data (paths, logs, vector DB).
# Secrets are NEVER in files (Windows Credential Manager) - this is
# only local state that doesn't belong in the repo.
settings.json
data/

# Local test rig (contains theme/video media - never publish)
test_hs/
Arcade/

# Local GitHub token - must NEVER be committed
token.txt

# Local test screenshots / cab photos dropped in the project root
/*.jpg
/*.png

# Bundled Theme Suite (large binaries: deno/ffmpeg/ruffle) - ships in the
# release zip, not in the repo
theme_suite/

# Local API-key drop files (the key belongs in the Credential Manager via
# the Setup tab - these must never reach the repo)
APIKEY.txt
apikey.txt
token.txt
